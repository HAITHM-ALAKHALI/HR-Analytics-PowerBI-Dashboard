	lineageTag: ce9d3427-09e5-40bd-99dc-ea6f14d58df0

	measure 'Attrition Rate %' = DIVIDE(SUM('HR_Analytics-4 (2)'[AttritionCount]),SUM('HR_Analytics-4 (2)'[EmployeeCount]),0)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9e2b1da8-1a9e-4791-a25e-e4cf4f399604

	measure 'Attrition Rate by Age Group' =
			
